# Runtime database connection. On Vercel, use the Supabase Transaction pooler
# URL from Dashboard > Connect (port 6543) with sslmode=require.
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require

# Optional compatibility fallback used by the local sandbox.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Used only by drizzle-kit push/migrations. Prefer Supabase Direct connection or
# Session pooler (port 5432); never expose either database URL to the browser.
DIRECT_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Canonical production URL used in receipts and metadata.
SITE_URL=https://your-domain.vercel.app

# Admin credentials (server-side only; never prefix with NEXT_PUBLIC_).
ADMIN_USER_ID=replace-with-your-admin-user-id
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
ADMIN_SESSION_SECRET=replace-with-a-separate-random-secret
